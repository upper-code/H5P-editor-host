HOST=127.0.0.1
PORT=8090
H5P_HOST_ROUTE_PREFIX=/h5p-editor-core
# pino log level: trace | debug | info | warn | error | fatal (default: info).
LOG_LEVEL=info
# `development` echoes error details in 500 responses and enables H5P i18n
# debugging; `production` requires H5P_HOST_SHARED_SECRET (no dev default).
# NODE_ENV=production
H5P_HOST_SHARED_SECRET=replace-with-a-long-random-secret
H5P_HOST_DATA_DIR=.host-data
# Untracked runtime library directory (default: $H5P_HOST_DATA_DIR/libraries).
H5P_LIBRARIES_DIR=.host-data/libraries
# Where multipart uploads are staged before H5P takes them over
# (default: $H5P_HOST_DATA_DIR/upload-tmp).
H5P_HOST_UPLOAD_TMP_DIR=.host-data/upload-tmp
# Source used by `npm run provision:libraries` to populate the directory above:
# a mounted volume or an unpacked release artifact of H5P library folders.
H5P_LIBRARY_SOURCE_DIR=
# Where `npm run licenses` writes the library license inventory
# (default: THIRD-PARTY-LIBRARIES.md in the repository root).
LICENSE_INVENTORY_OUT=
EDITOR_PUBLIC_URL=http://localhost:8080/editor
EDITOR_LANGUAGE=en
# Per-file upload ceiling in bytes for editor uploads and .h5p imports
# (default: 268435456 = 256 MiB).
EDITOR_MAX_UPLOAD_BYTES=268435456
# Whole-request multipart ceiling in bytes, checked from Content-Length before
# anything is staged to disk (default: 1073741824 = 1 GiB; 0 disables). A
# chunked request that sends no length is bounded only by the per-file limit
# above, so the reverse proxy must cap the request body too.
H5P_HOST_MAX_MULTIPART_BYTES=1073741824
# Most files one multipart request may carry (default: 64). H5P uploads one file
# per request; the cap stops a burst of tiny files from filling the staging dir.
H5P_HOST_MAX_UPLOAD_FILES=64
# Optional CDN origin for the static H5P core/library assets. Unset serves them
# from this app; set e.g. https://cdn.example.com to offload them.
CDN_BASE=

# --- Security / operations ---
# Comma-separated origins allowed to frame this service and to be used as the
# iframe's `parentOrigin`. Unset means the same-origin (reverse-proxied)
# deployment: `frame-ancestors 'self'`.
H5P_HOST_ALLOWED_PARENTS=
# Cap on a tenant's staged (unsaved) editor uploads. 0 disables the check.
H5P_HOST_MAX_TEMP_BYTES=1073741824
# In-memory tenant (distributor) cache. Eviction only drops a tenant's editor
# from memory — never its on-disk content. Max LRU entries, and idle TTL in ms
# (0 keeps entries until the size cap evicts them).
H5P_HOST_TENANT_CACHE_MAX=100
H5P_HOST_TENANT_CACHE_TTL_MS=1800000
# Cap on tenants being constructed at the same time; a new tenant over the
# limit receives 503 and may be retried (cached tenants are unaffected).
H5P_HOST_TENANT_INIT_MAX=16
# Temporary-file expiry and how often the janitor sweeps for expired files.
H5P_HOST_TEMP_FILE_LIFETIME_MS=7200000
H5P_HOST_TEMP_SWEEP_INTERVAL_MS=900000
# How long a /ready answer is reused before the library directory is scanned
# again (the probe reads every provisioned manifest). 0 scans on every call.
H5P_HOST_READINESS_CACHE_MS=5000
# On SIGTERM/SIGINT: stop accepting, wait this long for in-flight requests.
H5P_HOST_SHUTDOWN_GRACE_MS=20000
# A tenant's content mutations (save, generated content, import, delete,
# acknowledgement) run one at a time; `/api/v1/content/...` reads run
# concurrently with each other but not with a write, so a revision and its
# parameters always come from one complete version. This is how long any of
# them waits for its turn before it is answered 503 and may be retried — the
# bound that keeps a slow client's download from holding up a save.
H5P_HOST_MUTATION_WAIT_MS=30000
# How long a journal entry is kept once the embedder has acknowledged it: long
# enough that a replayed Idempotency-Key still answers from the receipt rather
# than writing a second time. Abandoned staging directories expire on the same
# window. An ordinary unacknowledged write is never removed by age — it is the
# only record of a write nobody has been charged for.
#
# The exception is a generation write: the `POST /api/v1/generated-content`
# save and the `rollback` delete that compensates it. The embedder books those
# from its own job pipeline rather than through pending-usage, so they expire on
# this window even while unacknowledged. Once one is gone a replayed
# Idempotency-Key for it no longer answers from the receipt and may write a
# second time, so set this at least as long as the longest a generation job can
# take to retry.
H5P_HOST_OPERATION_RETENTION_MS=604800000
# How long a lock whose owner is on ANOTHER machine is honoured without a
# heartbeat. An owner on this machine is judged by whether its process still
# exists — gone frees the lock at once, still running holds it however old the
# file is — so this window does not apply to it.
H5P_HOST_LOCK_STALE_MS=60000
# The longest a lock is honoured on the strength of its owner's pid alone. A
# pid is not an identity — a machine that comes back with the same hostname and
# hands the same number to an unrelated process would otherwise leave a lock
# nothing can take. No save runs for an hour, so a lock that has gone that long
# without a heartbeat is taken over and its journal replayed.
H5P_HOST_LOCK_MAX_HOLD_MS=3600000
# How long the start waits for one tenant's lock before it leaves that tenant's
# journal to whichever process already holds it.
H5P_HOST_RECOVERY_WAIT_MS=5000
# How often every tenant's settled journal entries and abandoned lock files are
# swept. Their expiry windows are days, so this only has to happen at all — it
# does not have to be prompt. 0 disables the sweep.
H5P_HOST_JOURNAL_SWEEP_INTERVAL_MS=21600000
